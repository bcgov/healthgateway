        "version:bump": "node scripts/bump-version.js",
        "lintcheck": "npm run lintcheck:app",
        "lintcheck:app": "npm run types && eslint . --max-warnings 0 && prettier --check .",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "private": true,
    "main": "expo-router/entry",
    "allowScripts": {
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true
