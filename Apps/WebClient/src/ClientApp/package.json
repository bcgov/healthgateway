{
    "name": "gateway-client",
    "private": true,
    "version": "2.0.0-alpha",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && npm run lintcheck && vite build",
        "preview": "vite preview",
        "lintcheck": "eslint src --max-warnings 0 && prettier src --check",
        "lint": "eslint src --fix && prettier src --write"
    },
    "comments": {
        "overrides": "typescript-eslint 8.65.0 reports call-signature parameter names in type literals as unused vars, firing on every defineEmits<{ (e: '...'): void }>() declaration (682 warnings). Pinned to 8.64.0; remove once upstream stops flagging them."
    },
    "overrides": {
        "typescript-eslint": "8.64.0",
        "@typescript-eslint/eslint-plugin": "8.64.0",
        "@typescript-eslint/parser": "8.64.0",
        "@typescript-eslint/utils": "8.64.0"
    },
