        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "@vuepic/vue-datepicker": "^14.0.0",
        "axios": "^1.19.0",
        "file-saver": "^2.0.5",
        "html2canvas": "^1.4.1",
        "keycloak-js": "^26.2.4",
        "loglevel": "^1.9.2",
        "luxon": "^3.7.2",
        "maska": "^3.2.0",
        "pinia": "^4.0.3",
        "pinia-plugin-persistedstate": "^4.7.1",
