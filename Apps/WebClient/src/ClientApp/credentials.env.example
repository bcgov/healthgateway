# Copy to credentials.env (same folder, never committed) and fill in a BC Services Card test login for Development.
# Maestro passes every MAESTRO_* variable to the flows, which read them as ${MAESTRO_HG_USERNAME} and so on.
# Load it only through scripts/maestro-test.sh, which hides these values in anything it prints.
MAESTRO_HG_USERNAME=
MAESTRO_HG_PASSWORD=
# A second test account whose PharmaNet medications are protected, for records/protective-word.yaml, and its
# protective word. The flow fails, saying so, while these are empty.
MAESTRO_HG_PROTECTED_USERNAME=
MAESTRO_HG_PROTECTED_PASSWORD=
MAESTRO_HG_PROTECTIVE_WORD=
