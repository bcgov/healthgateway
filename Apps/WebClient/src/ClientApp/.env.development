# Committed defaults for `npm run dev` / `expo start` (NODE_ENV=development); `npm run build` does not read this file.
# All values are public; never put secrets here. To override one, use .env.local or .env.development.local (both
# ignored): this file outranks a plain .env.

# Web: the .NET WebClient (Aspire / SpaProxy on 3025) answers /configuration; Metro on 5002 only serves the bundle.
EXPO_PUBLIC_WEB_CLIENT_BASE_URI=http://localhost:3025/

# Snowplow analytics is ON locally, as the old Vue client was; EXPO_PUBLIC_SNOWPLOW_ENABLED=false in a .env switches it off.
