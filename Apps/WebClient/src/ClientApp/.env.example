# Copy to .env (or .env.local) and adjust. All values are public; never put secrets here.
# Web run from the CLI: the server to load /configuration from. Without it, the server that hosted the app.
EXPO_PUBLIC_WEB_CLIENT_BASE_URI=http://localhost:3025/

# Snowplow analytics (same collector/schema as the web client). On locally, as the old Vue client was; false switches it off.
EXPO_PUBLIC_SNOWPLOW_ENABLED=true
EXPO_PUBLIC_SNOWPLOW_COLLECTOR=spt.apps.gov.bc.ca
EXPO_PUBLIC_SNOWPLOW_APP_ID=Snowplow_standalone

# Apple development team for physical-device builds (Xcode > Settings > Accounts; a free personal team works).
APPLE_TEAM_ID=
