{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended"],

    // config:recommended pulls in :ignoreModulesAndTests, which ignores **/test/** and
    // **/tests/**. That would silently drop Testing/functional/tests and the unit-test
    // projects. We want those covered, so only ignore node_modules.
    ignorePaths: ["**/node_modules/**"],

    ignoreDeps: [
        // Deliberately pinned to a beta in Apps/Directory.Build.props; see comment there.
        "StyleCop.Analyzers",
    ],

    // PRs into dev are squash-merged; have Renovate do the same when it automerges.
    automergeStrategy: "squash",

    // The azure-pipelines manager (disabled by default) is intentionally left off. When
    // pointed at Build/ and Tools/Pipelines/ it only proposes pinning task refs such as
    // Bash@3 to Bash@3.279.1, which is not how ADO tasks are normally versioned.

    packageRules: [
        {
            // Keep container image bumps out of the nuget "dotnet monorepo" groups so a
            // mcr.microsoft.com/dotnet/aspnet major does not ride along with package updates.
            matchDatasources: ["docker"],
            groupName: null,
            additionalBranchPrefix: "docker-",
        },
        {
            // Test-only tooling: group so one PR touches all 16 test csproj files.
            matchDatasources: ["nuget"],
            matchPackageNames: ["Moq", "xunit.v3.mtp-off", "xunit.runner.visualstudio", "coverlet.collector", "coverlet.msbuild", "Shouldly", "FluentAssertions", "Microsoft.NET.Test.Sdk"],
            groupName: "dotnet test tooling",
        },
        {
            // Tools/Postgres builds a legacy postgres:11 image; a jump to 18 is not a
            // routine dependency update. Review this one manually.
            matchFileNames: ["Tools/Postgres/**"],
            matchDepNames: ["postgres"],
            enabled: false,
        },
        {
            // Majors are breaking by definition. List them on the Dependency Dashboard
            // issue and only open a PR once the checkbox is ticked there.
            matchUpdateTypes: ["major"],
            dependencyDashboardApproval: true,
        },
        {
            // Non-breaking nuget and npm updates: automerge once the branch is green.
            // Renovate only automerges when status checks exist and pass, so the ADO
            // pipeline must run on renovate/* branches for this to take effect.
            // 0.x packages are excluded because their minors are routinely breaking.
            matchDatasources: ["nuget", "npm"],
            matchUpdateTypes: ["minor", "patch", "lockFileMaintenance"],
            matchCurrentVersion: "!/^[~^]?0\\./",
            automerge: true,
            // Let a release sit before automerging it; main defence against a
            // compromised/yanked package being pulled in without a human looking.
            minimumReleaseAge: "3 days",
        },
    ],
}
